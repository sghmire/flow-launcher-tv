<?xml version="1.0" encoding="utf-8"?>
<!-- The app surfaces out of the dark the launcher has just closed down to. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="240" />
    <scale android:fromXScale="0.97" android:toXScale="1" android:fromYScale="0.97" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" />
</set>
